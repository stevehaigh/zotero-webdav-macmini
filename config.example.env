# zotero-webdav configuration.
# install.sh copies this to ~/.config/zotero-webdav/config.env (if it doesn't
# already exist) and fills in detected values. Edit that copy, not this file.
# After editing, restart the server:
#   macOS:  sudo launchctl kickstart -k system/io.github.stevehaigh.zotero-webdav
#   Linux:  sudo systemctl restart zotero-webdav

# Folder served over WebDAV. Zotero stores attachments in DATA_DIR/zotero/.
# On macOS, keep it outside ~/Documents, ~/Desktop and ~/Downloads: privacy
# controls block background services from those folders.
DATA_DIR="$HOME/ZoteroDAV"

# If DATA_DIR is on an external drive, that drive's mount point
# (e.g. "/mnt/zotero" or "/Volumes/Zotero"). The server and backup refuse to
# run while it isn't mounted, rather than serving an empty folder that would
# look to Zotero as if every file had been deleted. install.sh fills this in.
REQUIRE_MOUNTPOINT=""

# Address and port to listen on.
#   ""            all interfaces (LAN + Tailscale), the default
#   "127.0.0.1"   localhost only; use with zwd-tailscale-https
BIND_ADDR=""
PORT="8080"

# Username/password hash file, managed by zwd-set-password.
HTPASSWD_FILE="$HOME/.config/zotero-webdav/htpasswd"

# Full path to rclone (services don't use your shell's PATH).
# Typically /opt/homebrew/bin/rclone on macOS, /usr/bin/rclone on Linux.
RCLONE_BIN="/opt/homebrew/bin/rclone"

# rclone log level: ERROR, NOTICE, INFO or DEBUG. INFO logs every request.
LOG_LEVEL="NOTICE"

# Where zwd-backup copies the data. Either a local folder (on macOS, normally
# inside the OneDrive folder) or an rclone remote such as
# "onedrive:Backups/ZoteroDAV", the default on Linux (see docs/backup.md).
# Leave empty to disable backups.
BACKUP_DEST="$HOME/Library/CloudStorage/OneDrive-Personal/Backups/ZoteroDAV"

# Keep previous versions of changed or deleted files for this many days.
BACKUP_KEEP_DAYS="90"

# Daily backup time (24-hour clock). Re-run install.sh after changing these.
BACKUP_HOUR="3"
BACKUP_MINUTE="30"
