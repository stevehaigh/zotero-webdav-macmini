#!/bin/bash
# Create or replace the WebDAV username and password (stored as a bcrypt hash).
#   zwd-set-password               prompt for username and password, then restart the server
#   zwd-set-password --no-restart  as above, but leave the server alone (used by install.sh)
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"

restart=1
[[ "${1:-}" == "--no-restart" ]] && restart=0

HTPASSWD_FILE="$ZWD_CONFIG_DIR/htpasswd"
[[ -f "$ZWD_CONFIG" ]] && { load_config; }
mkdir -p "$(dirname "$HTPASSWD_FILE")"

default_user="$(id -un)"
read -r -p "WebDAV username [$default_user]: " user
user="${user:-$default_user}"
[[ "$user" =~ ^[A-Za-z0-9._-]+$ ]] || die "Username may only contain letters, digits, '.', '_' and '-'."

while :; do
  read -r -s -p "WebDAV password (you will type this into Zotero): " pw1; echo
  read -r -s -p "Repeat password: " pw2; echo
  [[ "$pw1" == "$pw2" ]] || { warn "Passwords do not match, try again."; continue; }
  (( ${#pw1} >= 12 )) || { warn "Use at least 12 characters."; continue; }
  break
done

umask 077
tmp="$(mktemp)"
if command -v htpasswd >/dev/null 2>&1; then
  # macOS ships Apache's htpasswd at /usr/sbin/htpasswd; -B = bcrypt.
  printf '%s' "$pw1" | htpasswd -niB -C 10 "$user" | head -n 1 > "$tmp"
elif command -v openssl >/dev/null 2>&1; then
  printf '%s:%s\n' "$user" "$(printf '%s' "$pw1" | openssl passwd -apr1 -stdin)" > "$tmp"
else
  rm -f "$tmp"; die "Need either htpasswd or openssl to hash the password."
fi
mv "$tmp" "$HTPASSWD_FILE"
chmod 600 "$HTPASSWD_FILE"
unset pw1 pw2
info "Saved credentials for '$user' to $HTPASSWD_FILE"

(( restart )) && restart_server
exit 0
